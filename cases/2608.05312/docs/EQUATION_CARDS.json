      ],
      "latex": "H=\\omega_a a^\\dagger a+\\varepsilon\\sum_i\\sigma_i^\\dagger\\sigma_i+\\sum_i g(a^\\dagger\\sigma_i+\\mathrm{h.c.})+\\sum_i t_i(\\sigma_i^\\dagger\\sigma_{i+1}+\\mathrm{h.c.}),\\quad t_i=t+\\delta t X_i",
