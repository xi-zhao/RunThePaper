{
  "schema_version": 1,
  "run_id": "paper-exact-v4",
  "target_ids": [
    "T001",
    "T002",
    "T003",
    "T004"
  ],
  "command": [
    "python",
    "scripts/run_reproduction.py",
    "--config",
    "config/paper_exact.json"
  ],
  "inputs": [
    "src/__init__.py",
    "src/sensing.py",
    "scripts/run_reproduction.py",
    "config/paper_exact.json",
    "config/fontlist-v390.json"
  ],
  "parameter_file": "config/paper_exact.json",
  "parameter_selector": "parameters",
  "expected_parameters": {
    "fringe_p_values": [
      0.75,
      0.15
    ],
    "theta_reference_over_pi": 0.3,
    "phi_over_pi_min": 0.0,
    "phi_over_pi_max": 4.0,
    "phi_points": 401,
    "expectation_theta_over_pi_min": -2.0,
    "expectation_theta_over_pi_max": 4.0,
    "expectation_theta_points": 601,
    "p_min": 0.001,
    "p_max": 0.999,
    "p_points_each_side": 500,
    "noise_p": 0.01,
    "noise_theta_over_pi": 0.3,
    "gamma_min": 0.0,
    "gamma_max": 0.6,
    "gamma_points": 301,
    "theta_derivative_step": 1e-05
  },
  "outputs": [
    "outputs/data/fig2_optimal.npz",
    "outputs/data/fig2_expectations.npz",
    "outputs/data/fig3a.npz",
    "outputs/data/fig3bc.npz",
    "outputs/figures/fig2_optimal.png",
    "outputs/figures/fig2_optimal_pixel_registered.png",
    "outputs/figures/fig2_expectations.png",
    "outputs/figures/fig3a.png",
    "outputs/figures/fig3a_pixel_registered.png",
    "outputs/figures/fig3a_ordering_audit.png",
    "outputs/figures/fig3bc.png",
    "outputs/figures/fig3bc_pixel_registered.png",
    "outputs/checks/fig2_science.json",
    "outputs/checks/fig2_expectations_science.json",
    "outputs/checks/fig3a_science.json",
    "outputs/checks/fig3bc_science.json",
    "outputs/checks/reproduction_summary.json"
  ],
  "timeout_seconds": 600,
  "environment": {
    "OMP_NUM_THREADS": "1"
  }
}
