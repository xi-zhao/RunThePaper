{
  "schema_version": 1,
  "data_manifest": "outputs/checks/generated_data_manifest.json",
  "numerical_arrays_mutable": false,
  "source_images_allowed_after_freeze": true,
  "allowed_adjustments": [
    "canvas_size",
    "axes_position",
    "font_family",
    "font_size",
    "line_width",
    "line_style",
    "palette",
    "marker_size",
    "raster_interpolation"
  ],
  "forbidden_adjustments": [
    "physical_parameters",
    "numerical_arrays",
    "random_seed",
    "trajectory_outcomes",
    "source_pixels_as_data",
    "source_vector_coordinates_as_data",
    "author_code",
    "author_numerical_arrays"
  ],
  "primary_metric_scope": "predeclared scientific numerical panels",
  "full_canvas_metric_role": "layout diagnostic only"
}
