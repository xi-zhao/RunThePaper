        {
          "id": "EQ001-C2",
          "type": "symbolic_identity",
          "status": "passed",
          "reason": "The Hamiltonian is Hermitian and conserves total excitation in the stated single-excitation manifold."
        }
      ],
      "numerical_form": "H[0,i]=H[i,0]=g; H[i,i+1]=H[i+1,i]=t_mean+delta_t*X[i]",
