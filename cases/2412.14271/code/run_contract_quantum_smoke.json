{
  "schema_version": 1,
  "run_id": "quantum-isolation-smoke-v2",
  "target_ids": [
    "T002"
  ],
  "command": [
    "python",
    "scripts/run_quantum_smoke.py",
    "--config",
    "config/quantum_smoke.json"
  ],
  "inputs": [
    "src/__init__.py",
    "src/dicke.py",
    "scripts/run_quantum_smoke.py",
    "config/quantum_smoke.json",
    "config/matplotlib"
  ],
  "parameter_file": "config/quantum_smoke.json",
  "parameter_selector": "parameters",
  "expected_parameters": {
    "N": 2,
    "M": 12,
    "lambda": 0.62,
    "omega_c": 1.0,
    "omega_a": 1.0,
    "kappa1": 0.4,
    "kappa2": 0.2,
    "trajectories": 1,
    "final_time": 0.2,
    "seed": 6001
  },
  "outputs": [
    "outputs/checks/quantum_isolation_smoke.json"
  ],
  "timeout_seconds": 60,
  "environment": {
    "MPLCONFIGDIR": "config/matplotlib",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "VECLIB_MAXIMUM_THREADS": "1"
  }
}
